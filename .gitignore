# OddBrain master repo .gitignore

# Dependencies
node_modules/
.pnp
.pnp.js

# Builds
dist/
/dist-web/
/apps/*/dist-web/
build/
/packages/Memory_OB/dist-addon/
out/

# The app's own mark is source and lives in resources/, which is tracked like any
# other source file. It used to sit in build/ with a negation to keep it — but that
# directory name is excluded from this project's workspace snapshots, so the icon
# kept vanishing from the working tree.
.next/
.nuxt/
.output/
.parcel-cache/
.svelte-kit/
.turbo/
coverage/
target/

# Caches
.cache/
.local/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.nox/
.tox/
.venv/
__pycache__/
*.pyc
*.pyo

# Env
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Ollama models (don't commit large models)
ollama/
/models/

# Vault private data (optional — user may want to keep vault private, but starter is OK)
# Uncomment if you don't want to push real vault data:
# vault/Brain/02 Sources/
# vault/Brain/03 Memory/
# vault/Brain/08 Journal/
# vault/Brain/09 Activity & Undo/

# Archive zips — don't push nested zips to avoid recursion, keep reference only
archive_zips/
*.zip
!apps/*/archive_zips/

# Keep living docs, .ai/, spec/, extension/, apps/ source
# Don't ignore:
# !00_LIVING_DOCS/
# !.ai/
# !spec/
# !extension/
# !vault/Brain/00 System/
# !vault/Brain/01 Inbox/README.md
# etc

# Temporary
tmp/
temp/
*.tmp

# CI failure reports (posted as commit comments, never committed)
junit-*.xml
