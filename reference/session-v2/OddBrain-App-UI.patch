+(async()=>{let app;const report={errors:[],checks:[],modelCalls:0};const calls=[];const server=http.createServer(async(req,res)=>{let raw='';for await(const part of req)raw+=part;const body=raw?JSON.parse(raw):null;res.setHeader('content-type','application/json');if(req.url==='/api/tags')res.end(JSON.stringify({models:[{name:'qwen:3b',size:1900000000},{name:'opaque-cloud',remote_model:'remote-model'}]}));else if(req.url==='/api/show')res.end(JSON.stringify({capabilities:['completion']}));else if(req.url==='/api/chat'){calls.push(body);res.end(JSON.stringify({done:true,message:{content:'CLEAN'}}))}else res.end('{}')});
