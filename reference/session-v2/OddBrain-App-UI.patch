+  return { ...Object.fromEntries(Object.entries(t).map(([k, v]) => ['--color-' + k, v])), '--color-accent': accent, '--accent-ink': accentInk, '--font-sans': font.stack, '--ob-heading-font': look.interfaceFont === 'editorial' ? "Georgia, 'Times New Roman', serif" : font.stack, '--ob-radius': look.style === 'ink' ? '4px' : look.style === 'soft' ? '18px' : look.style === 'glass' ? '12px' : '14px', '--ob-control-radius': look.style === 'ink' ? '3px' : look.style === 'soft' ? '10px' : '8px', '--ob-border-size': look.style === 'ink' ? '1.3px' : '1px', '--ob-header-bg': look.style === 'glass' ? t.card : t.bg, '--ob-accent-text': accentText, '--ob-message-gap': look.density === 'compact' ? '20px' : '28px', '--ob-row-pad': look.density === 'compact' ? '8px' : '12px', '--ob-focus': ring, '--ob-scheme': dark ? 'dark' : 'light', ...(look.chatFollowsInterface ? { '--transcript-font': font.stack } : {}) }
+}
+export function applyLook(appearance: Appearance, look: LookPreferences): void {
+  const root = document.documentElement
+  const tokens = lookTokens(appearance, look, window.matchMedia('(prefers-color-scheme: dark)').matches)
+  for (const [k, v] of Object.entries(tokens)) root.style.setProperty(k, v)
