{
  "name": "oddbrain",
  "version": "0.9.0",
  "private": true,
  "description": "OddBrain \u2014 a local-first desktop assistant. Your files, your models, your machine.",
  "author": "",
  "license": "Apache-2.0",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "npm run typecheck && electron-vite build && node scripts/build-ui-preview.mjs",
    "build:web": "node scripts/build-ui-preview.mjs && vite build --config vite.web.config.ts",
    "start": "electron-vite preview",
    "preview:web": "vite preview --config vite.web.config.ts --port 4174",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "electron-vite build && electron . --smoke",
    "dist:win": "npm run build && electron-builder --win",
    "dist:win:dir": "npm run build && electron-builder --win --dir",
    "dist:linux": "npm run build && electron-builder --linux",
    "build:ui-preview": "node scripts/build-ui-preview.mjs",
    "test:ui": "node scripts/check-ui.cjs && node scripts/check-ui-turns.cjs && node scripts/check-ui-standalone.cjs && node scripts/check-ui-motion.cjs && node scripts/check-ui-integration.cjs && node scripts/check-ui-media.cjs",
    "test:media:native": "npm run build && node scripts/check-media-native.cjs"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@napi-rs/canvas": "^1.0.11",
    "@tesseract.js-data/eng": "^1.0.0",
    "image-size": "^2.0.4",
    "lucide-react": "^0.469.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tesseract.js": "^7.0.0",
    "word-extractor": "^1.0.4",
    "yaml": "^2.9.1",
    "yauzl": "^3.4.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/word-extractor": "^1.0.6",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^41.10.7",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^24.1.3",
    "playwright-core": "^1.64.1",
    "png-to-ico": "^3.0.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "sprintf-js": "^1.1.2",
    "global-agent": "^4.1.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
