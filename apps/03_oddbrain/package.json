{
  "name": "oddbrain-desktop",
  "version": "1.0.0-alpha.1",
  "private": true,
  "description": "OddBrain, a local-first desktop workspace",
  "license": "Apache-2.0",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "npm run typecheck && electron-vite build",
    "build:web": "vite build --config vite.web.config.ts",
    "preview:web": "vite preview --config vite.web.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "electron . --smoke",
    "dist:win": "npm run build && electron-builder --win",
    "dist:win:dir": "npm run build && electron-builder --win --dir",
    "format": "prettier --write 'src/**/*.{ts,tsx,css,html}' 'tests/**/*.{ts,tsx}' '*.{json,ts,mts}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css,html}' 'tests/**/*.{ts,tsx}' '*.{json,ts,mts}'"
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^41.10.7",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^24.1.3",
    "prettier": "^3.9.10",
    "typescript": "^5.7.2",
    "vite": "^6.4.4",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=22.12"
  },
  "prettier": {
    "singleQuote": true,
    "semi": false,
    "printWidth": 108
  }
}
