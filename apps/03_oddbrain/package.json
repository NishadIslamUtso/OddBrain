{
  "name": "oddbrain",
  "version": "0.9.0",
  "private": true,
  "description": "OddBrain — a local-first desktop assistant. Your files, your models, your machine.",
  "author": "",
  "license": "Apache-2.0",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "npm run typecheck && electron-vite build",
    "build:web": "vite build --config vite.web.config.ts",
    "start": "electron-vite preview",
    "preview:web": "vite preview --config vite.web.config.ts --port 4174",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "electron-vite build && electron . --smoke",
    "dist:win": "npm run build && electron-builder --win",
    "dist:win:dir": "npm run build && electron-builder --win --dir",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "lucide-react": "^0.469.0",
    "pdfjs-dist": "^5.4.296",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yaml": "^2.9.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^41.10.7",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^24.1.3",
    "playwright-core": "^1.64.1",
    "png-to-ico": "^3.0.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.4.4",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "sprintf-js": "^1.1.2"
  },
  "engines": {
    "node": ">=22.12"
  }
}
